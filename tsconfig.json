{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "src",
    "maps",
    "test"
  ]
}
